+#include "lib/btstack/src/ble/le_device_db_tlv.h"
+
+// Secret type used for BTstack TLV entries (le_device_db, SM ER/IR).
+// The key passed to _IRQ_GET_SECRET/_IRQ_SET_SECRET is the 4-byte big-endian tag.
+#define MP_BLUETOOTH_BTSTACK_SECRET_TYPE_TLV (0x10)
+
+static void tlv_key(uint32_t tag, uint8_t *key) {
+    big_endian_store_32(key, 0, tag);
+}
+
+// BTstack TLV backed by the Python _IRQ_GET_SECRET/_IRQ_SET_SECRET handlers,
+// so pairing keys survive a reset when the application persists them.
+static int mp_btstack_tlv_get_tag(void *context, uint32_t tag, uint8_t *buffer, uint32_t buffer_size) {
+    (void)context;
+    uint8_t key[4];
+    tlv_key(tag, key);
+    const uint8_t *value;
+    size_t value_len;
+    if (!mp_bluetooth_gap_on_get_secret(MP_BLUETOOTH_BTSTACK_SECRET_TYPE_TLV, 0, key, sizeof(key), &value, &value_len)) {
+        return 0;
+    }
+    if (buffer != NULL) {
+        memcpy(buffer, value, MIN(buffer_size, value_len));
+    }
+    return value_len;
+}
+
+static int mp_btstack_tlv_store_tag(void *context, uint32_t tag, const uint8_t *data, uint32_t data_size) {
+    (void)context;
+    uint8_t key[4];
+    tlv_key(tag, key);
+    return mp_bluetooth_gap_on_set_secret(MP_BLUETOOTH_BTSTACK_SECRET_TYPE_TLV, key, sizeof(key), data, data_size) ? 0 : 1;
+}
+
+static void mp_btstack_tlv_delete_tag(void *context, uint32_t tag) {
+    (void)context;
+    uint8_t key[4];
+    tlv_key(tag, key);
+    mp_bluetooth_gap_on_set_secret(MP_BLUETOOTH_BTSTACK_SECRET_TYPE_TLV, key, sizeof(key), NULL, 0);
+}
+
+static const btstack_tlv_t mp_btstack_tlv_impl = {
+    &mp_btstack_tlv_get_tag,
+    &mp_btstack_tlv_store_tag,
+    &mp_btstack_tlv_delete_tag,
+};
+
+static void btstack_packet_handler_sm(uint8_t packet_type, uint16_t channel, uint8_t *packet, uint16_t size);
+static void mp_bluetooth_btstack_sm_apply(void);
+
+static btstack_packet_callback_registration_t sm_event_callback_registration = {
+    .callback = &btstack_packet_handler_sm
+};
 #endif
 
