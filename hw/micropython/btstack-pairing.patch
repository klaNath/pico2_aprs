+static bool mp_bluetooth_btstack_sm_mitm_required(void) {
+    return (mp_bluetooth_btstack_sm_auth_req & SM_AUTHREQ_MITM_PROTECTION) != 0;
+}
+
+static void mp_bluetooth_btstack_sm_apply(void) {
+    sm_set_authentication_requirements(mp_bluetooth_btstack_sm_auth_req);
+    // With both MITM and LE Secure requested, accept only authenticated LE Secure
+    // Connections pairing. Otherwise a peer could fall back to legacy pairing
+    // (passkey recoverable from a sniffed exchange) or to Just Works.
+    bool strict = mp_bluetooth_btstack_sm_mitm_required()
+        && (mp_bluetooth_btstack_sm_auth_req & SM_AUTHREQ_SECURE_CONNECTION);
+    sm_set_secure_connections_only_mode(strict);
+    if (strict) {
+        sm_set_accepted_stk_generation_methods(SM_STK_GENERATION_METHOD_PASSKEY
+            | SM_STK_GENERATION_METHOD_NUMERIC_COMPARISON);
+    } else {
+        sm_set_accepted_stk_generation_methods(SM_STK_GENERATION_METHOD_JUST_WORKS
+            | SM_STK_GENERATION_METHOD_OOB
+            | SM_STK_GENERATION_METHOD_PASSKEY
+            | SM_STK_GENERATION_METHOD_NUMERIC_COMPARISON);
+    }
+}
